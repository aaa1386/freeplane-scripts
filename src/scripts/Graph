import javax.swing.*
import java.awt.*
import java.awt.event.*


// ============================================================
// Node انتخاب شده Freeplane
// ============================================================

def selectedNode = node


// ============================================================
// Graph Node
// ============================================================

class GNode {

    def fpNode

    double x
    double y

    boolean selected


    GNode(
        def fpNode,
        double x,
        double y,
        boolean selected
    ) {

        this.fpNode = fpNode
        this.x = x
        this.y = y
        this.selected = selected
    }


    String getText() {

        return fpNode.text ?: "(empty)"
    }


    String getId() {

        return fpNode.nodeID
    }
}


// ============================================================
// Graph Edge
// ============================================================

class GEdge {

    GNode source
    GNode target

    def connector


    GEdge(
        GNode source,
        GNode target,
        def connector
    ) {

        this.source = source
        this.target = target
        this.connector = connector
    }
}


// ============================================================
// Graph Panel
// ============================================================

class GraphPanel extends JPanel {

    def ownerNode
    def controller


    def graphNodes = []
    def graphEdges = []


    // ========================================================
    // Nodeهایی که دستی به Graph اضافه شده‌اند
    // ========================================================

    Map<String, GNode> extraNodes = [:]


    // ========================================================
    // موقعیت‌های ذخیره‌شده
    // ========================================================

    Map<String, Point> savedPositions = [:]


    // ========================================================
    // آخرین Node انتخاب‌شده در Freeplane
    // ========================================================

    String lastSelectedNodeId = null


    // ========================================================
    // قفل Graph
    // ========================================================

    boolean graphLocked = false


    // ========================================================
    // Connector انتخاب شده
    // ========================================================

    GEdge selectedEdge = null


    // ========================================================
    // Node در حال Drag
    // ========================================================

    GNode draggedNode = null

    double dragOffsetX
    double dragOffsetY


    // ========================================================
    // Constructor
    // ========================================================

    GraphPanel(
        def ownerNode,
        def controller
    ) {

        this.ownerNode = ownerNode
        this.controller = controller


        setBackground(
            Color.WHITE
        )


        setFocusable(true)


        rebuildGraph()


        // ====================================================
        // Mouse
        // ====================================================

        MouseAdapter mouse =
            new MouseAdapter() {


                // =================================================
                // Mouse Pressed
                // =================================================

                @Override
                void mousePressed(
                    MouseEvent e
                ) {

                    requestFocusInWindow()


                    // ----------------------------------------
                    // کلیک راست روی Connector
                    // ----------------------------------------

                    if (
                        SwingUtilities.isRightMouseButton(e)
                    ) {

                        def edge =
                            findEdge(
                                e.x,
                                e.y
                            )


                        if (
                            edge != null
                        ) {

                            selectedEdge =
                                edge


                            repaint()


                            showConnectorMenu(
                                e.x,
                                e.y
                            )
                        }


                        return
                    }


                    // فقط کلیک چپ

                    if (
                        !SwingUtilities.isLeftMouseButton(e)
                    ) {

                        return
                    }


                    // ----------------------------------------
                    // پیدا کردن Node
                    // ----------------------------------------

                    def clickedNode =
                        findNode(
                            e.x,
                            e.y
                        )


                    if (
                        clickedNode != null
                    ) {

                        draggedNode =
                            clickedNode


                        dragOffsetX =
                            e.x -
                            clickedNode.x


                        dragOffsetY =
                            e.y -
                            clickedNode.y


                        println(
                            "================================"
                        )


                        println(
                            "GRAPH DRAG START"
                        )


                        println(
                            "Source: " +
                            clickedNode.text
                        )


                        return
                    }


                    // ----------------------------------------
                    // انتخاب Connector
                    // ----------------------------------------

                    selectedEdge =
                        findEdge(
                            e.x,
                            e.y
                        )


                    repaint()
                }


                // =================================================
                // Mouse Dragged
                // =================================================

                @Override
                void mouseDragged(
                    MouseEvent e
                ) {

                    if (
                        draggedNode == null
                    ) {

                        return
                    }


                    draggedNode.x =
                        e.x -
                        dragOffsetX


                    draggedNode.y =
                        e.y -
                        dragOffsetY


                    // ----------------------------------------
                    // ذخیره موقعیت
                    // ----------------------------------------

                    savedPositions[
                        draggedNode.getId()
                    ] =
                        new Point(
                            (int)draggedNode.x,
                            (int)draggedNode.y
                        )


                    repaint()
                }


                // =================================================
                // Mouse Released
                // =================================================

                @Override
                void mouseReleased(
                    MouseEvent e
                ) {

                    if (
                        draggedNode == null
                    ) {

                        return
                    }


                    // ----------------------------------------
                    // Source
                    // ----------------------------------------

                    def source =
                        draggedNode


                    println(
                        "GRAPH DRAG RELEASE"
                    )


                    println(
                        "Source: " +
                        source.text
                    )


                    // =================================================
                    // خیلی مهم:
                    //
                    // Source را از جستجوی Target حذف می‌کنیم.
                    //
                    // بنابراین وقتی Node را روی خودش رها کنیم،
                    // خودش Target محسوب نمی‌شود.
                    // =================================================

                    def target =
                        findTargetNode(
                            e.x,
                            e.y,
                            source
                        )


                    if (
                        target != null
                    ) {

                        println(
                            "Target: " +
                            target.text
                        )


                        // --------------------------------------------
                        // ایجاد Connector
                        // --------------------------------------------

                        createConnector(
                            source,
                            target
                        )

                    } else {

                        println(
                            "روی Node دیگری رها نشد."
                        )
                    }


                    // ----------------------------------------
                    // پایان Drag
                    // ----------------------------------------

                    draggedNode =
                        null


                    repaint()


                    println(
                        "================================"
                    )
                }
            }


        addMouseListener(
            mouse
        )


        addMouseMotionListener(
            mouse
        )


        // ====================================================
        // DELETE
        // ====================================================

        getInputMap(
            JComponent.WHEN_FOCUSED
        ).put(
            KeyStroke.getKeyStroke("DELETE"),
            "deleteConnector"
        )


        getActionMap().put(
            "deleteConnector",
            new AbstractAction() {

                @Override
                void actionPerformed(
                    ActionEvent e
                ) {

                    deleteSelectedConnector()
                }
            }
        )
    }


    // ========================================================
    // تغییر وضعیت قفل
    // ========================================================

    void setGraphLocked(
        boolean value
    ) {

        graphLocked =
            value


        repaint()
    }


    // ========================================================
    // بررسی تغییر Selection
    // ========================================================

    void checkSelectionChange() {

        try {

            def currentNode =
                controller.selected


            if (
                currentNode == null
            ) {

                return
            }


            String currentId =
                currentNode.nodeID


            if (
                currentId ==
                lastSelectedNodeId
            ) {

                return
            }


            lastSelectedNodeId =
                currentId


            // =================================================
            // حالت LOCK
            // =================================================

            if (
                graphLocked
            ) {

                addSelectedNodeToGraph(
                    currentNode
                )


                return
            }


            // =================================================
            // حالت عادی
            // =================================================

            ownerNode =
                currentNode


            rebuildGraph()


            repaint()


        } catch (Exception ex) {

            println(
                "Selection monitor: " +
                ex.message
            )
        }
    }


    // ========================================================
    // اضافه کردن Node انتخاب‌شده به Graph
    // ========================================================

    void addSelectedNodeToGraph(
        def fpNode
    ) {

        if (
            fpNode == null
        ) {

            return
        }


        String id =
            fpNode.nodeID


        if (
            id ==
            ownerNode.nodeID
        ) {

            return
        }


        def existing =
            graphNodes.find {

                it.getId() ==
                id
            }


        if (
            existing != null
        ) {

            graphNodes.each {

                it.selected =
                    false
            }


            existing.selected =
                true


            repaint()


            return
        }


        def extra =
            extraNodes[id]


        if (
            extra != null
        ) {

            if (
                !graphNodes.contains(extra)
            ) {

                graphNodes <<
                    extra
            }


            graphNodes.each {

                it.selected =
                    false
            }


            extra.selected =
                true


            repaint()


            return
        }


        int index =
            graphNodes.size()


        double x =
            850


        double y =
            120 +
            (
                index *
                100
            )


        Point saved =
            savedPositions[id]


        if (
            saved != null
        ) {

            x =
                saved.x

            y =
                saved.y
        }


        GNode newNode =
            new GNode(
                fpNode,
                x,
                y,
                true
            )


        extraNodes[id] =
            newNode


        graphNodes.each {

            it.selected =
                false
        }


        graphNodes <<
            newNode


        savedPositions[id] =
            new Point(
                (int)x,
                (int)y
            )


        repaint()
    }


    // ========================================================
    // بازسازی Graph
    // ========================================================

    void rebuildGraph() {

        // ----------------------------------------------------
        // ذخیره موقعیت
        // ----------------------------------------------------

        graphNodes.each { g ->

            try {

                savedPositions[
                    g.getId()
                ] =
                    new Point(
                        (int)g.x,
                        (int)g.y
                    )

            } catch (Exception ignored) {
            }
        }


        graphNodes.clear()

        graphEdges.clear()


        // ----------------------------------------------------
        // موقعیت Node مرکزی
        // ----------------------------------------------------

        Point centerPos =
            savedPositions[
                ownerNode.nodeID
            ]


        double centerX =
            centerPos != null ?
            centerPos.x :
            600


        double centerY =
            centerPos != null ?
            centerPos.y :
            400


        // ----------------------------------------------------
        // Node مرکزی
        // ----------------------------------------------------

        def center =
            new GNode(
                ownerNode,
                centerX,
                centerY,
                true
            )


        graphNodes <<
            center


        // ====================================================
        // Connectorهای خروجی
        // ====================================================

        int outIndex =
            0


        ownerNode.connectorsOut.each {

            connector ->


            try {

                def target =
                    connector.target


                if (
                    target == null
                ) {

                    return
                }


                GNode targetGraphNode =
                    graphNodes.find {

                        it.getId() ==
                        target.nodeID
                    }


                if (
                    targetGraphNode == null
                ) {

                    Point old =
                        savedPositions[
                            target.nodeID
                        ]


                    double x =
                        old != null ?
                        old.x :
                        850


                    double y =
                        old != null ?
                        old.y :
                        150 +
                        outIndex * 150


                    targetGraphNode =
                        new GNode(
                            target,
                            x,
                            y,
                            false
                        )


                    graphNodes <<
                        targetGraphNode
                }


                graphEdges <<
                    new GEdge(
                        center,
                        targetGraphNode,
                        connector
                    )


                outIndex++


            } catch (Exception ex) {

                println(
                    "OUT: " +
                    ex.message
                )
            }
        }


        // ====================================================
        // Connectorهای ورودی
        // ====================================================

        int inIndex =
            0


        ownerNode.connectorsIn.each {

            connector ->


            try {

                def source =
                    connector.source


                if (
                    source == null
                ) {

                    return
                }


                GNode sourceGraphNode =
                    graphNodes.find {

                        it.getId() ==
                        source.nodeID
                    }


                if (
                    sourceGraphNode == null
                ) {

                    Point old =
                        savedPositions[
                            source.nodeID
                        ]


                    double x =
                        old != null ?
                        old.x :
                        300


                    double y =
                        old != null ?
                        old.y :
                        150 +
                        inIndex * 150


                    sourceGraphNode =
                        new GNode(
                            source,
                            x,
                            y,
                            false
                        )


                    graphNodes <<
                        sourceGraphNode
                }


                boolean alreadyExists =
                    graphEdges.any {

                        it.connector.is(
                            connector
                        )
                    }


                if (
                    !alreadyExists
                ) {

                    graphEdges <<
                        new GEdge(
                            sourceGraphNode,
                            center,
                            connector
                        )
                }


                inIndex++


            } catch (Exception ex) {

                println(
                    "IN: " +
                    ex.message
                )
            }
        }


        // ====================================================
        // Nodeهای Extra
        // ====================================================

        extraNodes.values().each {

            extra ->


            if (
                extra.getId() ==
                ownerNode.nodeID
            ) {

                return
            }


            def existing =
                graphNodes.find {

                    it.getId() ==
                    extra.getId()
                }


            if (
                existing == null
            ) {

                Point saved =
                    savedPositions[
                        extra.getId()
                    ]


                if (
                    saved != null
                ) {

                    extra.x =
                        saved.x

                    extra.y =
                        saved.y
                }


                graphNodes <<
                    extra
            }
        }


        selectedEdge =
            null


        repaint()
    }


    // ========================================================
    // ایجاد Connector از Drag & Drop
    // ========================================================

    void createConnector(
        GNode sourceGraphNode,
        GNode targetGraphNode
    ) {

        try {

            def source =
                sourceGraphNode.fpNode


            def target =
                targetGraphNode.fpNode


            println(
                "================================"
            )


            println(
                "CREATE CONNECTOR FROM GRAPH"
            )


            println(
                "SOURCE = " +
                source.text
            )


            println(
                "TARGET = " +
                target.text
            )


            // =================================================
            // جلوگیری از اتصال Node به خودش
            // =================================================

            if (
                source.nodeID ==
                target.nodeID
            ) {

                println(
                    "Source و Target یکی هستند."
                )


                return
            }


            // =================================================
            // بررسی Connector موجود
            // =================================================

            boolean exists =
                false


            try {

                exists =
                    source.connectorsOut.any {

                        def t =
                            it.target


                        t != null &&
                        t.nodeID ==
                        target.nodeID
                    }

            } catch (Exception ex) {

                println(
                    "خطا در بررسی Connectorهای موجود: " +
                    ex.message
                )
            }


            if (
                exists
            ) {

                println(
                    "Connector از قبل وجود دارد."
                )


                JOptionPane.showMessageDialog(
                    this,

                    "Connector از قبل وجود دارد.",

                    "اطلاع",

                    JOptionPane.INFORMATION_MESSAGE
                )


                return
            }


            // =================================================
            // ایجاد Connector واقعی Freeplane
            // =================================================

            println(
                "در حال اجرای addConnectorTo..."
            )


            def connector =
                source.addConnectorTo(
                    target
                )


            println(
                "Connector ساخته شد."
            )


            // =================================================
            // جهت:
            //
            // Source → Target
            // =================================================

            connector.setStartArrow(
                false
            )


            connector.setEndArrow(
                true
            )


            // =================================================
            // اضافه کردن Edge به Graph
            // =================================================

            graphEdges <<
                new GEdge(
                    sourceGraphNode,
                    targetGraphNode,
                    connector
                )


            // =================================================
            // ذخیره موقعیت Nodeها
            // =================================================

            savedPositions[
                sourceGraphNode.getId()
            ] =
                new Point(
                    (int)sourceGraphNode.x,
                    (int)sourceGraphNode.y
                )


            savedPositions[
                targetGraphNode.getId()
            ] =
                new Point(
                    (int)targetGraphNode.x,
                    (int)targetGraphNode.y
                )


            repaint()


            println(
                source.text +
                " → " +
                target.text
            )


            println(
                "================================"
            )


            JOptionPane.showMessageDialog(
                this,

                "Connector ایجاد شد:\n\n" +
                source.text +
                "  →  " +
                target.text,

                "موفق",

                JOptionPane.INFORMATION_MESSAGE
            )


        } catch (
            Exception ex
        ) {

            println(
                "================================"
            )


            println(
                "ERROR CREATE CONNECTOR"
            )


            println(
                ex.message
            )


            ex.printStackTrace()


            JOptionPane.showMessageDialog(
                this,

                "خطا در ایجاد Connector:\n\n" +
                ex.message,

                "خطا",

                JOptionPane.ERROR_MESSAGE
            )
        }
    }


    // ========================================================
    // پیدا کردن Node
    // ========================================================

    GNode findNode(
        double mx,
        double my
    ) {

        for (
            GNode n :
            graphNodes
        ) {

            double dx =
                mx -
                n.x


            double dy =
                my -
                n.y


            double distance =
                Math.sqrt(
                    dx * dx +
                    dy * dy
                )


            if (
                distance <= 42
            ) {

                return n
            }
        }


        return null
    }


    // ========================================================
    // پیدا کردن Target
    //
    // Source حذف می‌شود.
    // ========================================================

    GNode findTargetNode(
        double mx,
        double my,
        GNode source
    ) {

        for (
            GNode n :
            graphNodes
        ) {

            // ----------------------------------------------
            // Source نمی‌تواند Target باشد
            // ----------------------------------------------

            if (
                n.is(source)
            ) {

                continue
            }


            double dx =
                mx -
                n.x


            double dy =
                my -
                n.y


            double distance =
                Math.sqrt(
                    dx * dx +
                    dy * dy
                )


            if (
                distance <= 42
            ) {

                return n
            }
        }


        return null
    }


    // ========================================================
    // حذف Connector
    // ========================================================

    void deleteSelectedConnector() {

        if (
            selectedEdge == null
        ) {

            return
        }


        try {

            def connector =
                selectedEdge.connector


            ownerNode.removeConnector(
                connector
            )


            rebuildGraph()


            repaint()


        } catch (Exception ex) {

            JOptionPane.showMessageDialog(
                this,

                "خطا در حذف Connector:\n\n" +
                ex.message,

                "خطا",

                JOptionPane.ERROR_MESSAGE
            )
        }
    }


    // ========================================================
    // دوطرفه کردن
    // ========================================================

    void makeBidirectional() {

        if (
            selectedEdge == null
        ) {

            return
        }


        try {

            def connector =
                selectedEdge.connector


            connector.setStartArrow(
                true
            )


            connector.setEndArrow(
                true
            )


            rebuildGraph()


            repaint()


        } catch (Exception ex) {

            JOptionPane.showMessageDialog(
                this,

                "خطا در دوطرفه کردن Connector:\n\n" +
                ex.message,

                "خطا",

                JOptionPane.ERROR_MESSAGE
            )
        }
    }


    // ========================================================
    // یک‌طرفه کردن
    // ========================================================

    void makeOneWay() {

        if (
            selectedEdge == null
        ) {

            return
        }


        try {

            def connector =
                selectedEdge.connector


            connector.setStartArrow(
                false
            )


            connector.setEndArrow(
                true
            )


            rebuildGraph()


            repaint()


        } catch (Exception ex) {

            JOptionPane.showMessageDialog(
                this,

                "خطا در یک‌طرفه کردن Connector:\n\n" +
                ex.message,

                "خطا",

                JOptionPane.ERROR_MESSAGE
            )
        }
    }


    // ========================================================
    // معکوس کردن
    // ========================================================

    void reverseConnector() {

        if (
            selectedEdge == null
        ) {

            return
        }


        try {

            def oldConnector =
                selectedEdge.connector


            def oldSource =
                selectedEdge.source.fpNode


            def oldTarget =
                selectedEdge.target.fpNode


            boolean reverseExists =
                oldTarget.connectorsOut.any {

                    it.target != null &&
                    it.target.nodeID ==
                    oldSource.nodeID
                }


            if (
                reverseExists
            ) {

                JOptionPane.showMessageDialog(
                    this,

                    "Connector معکوس از قبل وجود دارد.",

                    "اطلاع",

                    JOptionPane.INFORMATION_MESSAGE
                )


                return
            }


            ownerNode.removeConnector(
                oldConnector
            )


            def newConnector =
                oldTarget.addConnectorTo(
                    oldSource
                )


            newConnector.setStartArrow(
                false
            )


            newConnector.setEndArrow(
                true
            )


            rebuildGraph()


            repaint()


        } catch (Exception ex) {

            JOptionPane.showMessageDialog(
                this,

                "خطا در معکوس کردن Connector:\n\n" +
                ex.message,

                "خطا",

                JOptionPane.ERROR_MESSAGE
            )
        }
    }


    // ========================================================
    // منوی Connector
    // ========================================================

    void showConnectorMenu(
        int x,
        int y
    ) {

        if (
            selectedEdge == null
        ) {

            return
        }


        def connector =
            selectedEdge.connector


        boolean startArrow =
            connector.hasStartArrow()


        boolean endArrow =
            connector.hasEndArrow()


        JPopupMenu menu =
            new JPopupMenu()


        String state


        if (
            startArrow &&
            endArrow
        ) {

            state =
                "وضعیت: دوطرفه  ↔"

        } else if (
            endArrow
        ) {

            state =
                "وضعیت: " +
                selectedEdge.source.text +
                "  →  " +
                selectedEdge.target.text

        } else if (
            startArrow
        ) {

            state =
                "وضعیت: " +
                selectedEdge.target.text +
                "  →  " +
                selectedEdge.source.text

        } else {

            state =
                "وضعیت: بدون فلش"
        }


        JMenuItem stateItem =
            new JMenuItem(
                state
            )


        stateItem.setEnabled(
            false
        )


        menu.add(
            stateItem
        )


        menu.addSeparator()


        JMenuItem reverseItem =
            new JMenuItem(
                "↔ معکوس کردن جهت"
            )


        reverseItem.addActionListener {

            reverseConnector()
        }


        menu.add(
            reverseItem
        )


        if (
            startArrow &&
            endArrow
        ) {

            JMenuItem oneWayItem =
                new JMenuItem(
                    "→ تبدیل به یک‌طرفه"
                )


            oneWayItem.addActionListener {

                makeOneWay()
            }


            menu.add(
                oneWayItem
            )

        } else {

            JMenuItem bothItem =
                new JMenuItem(
                    "↔ دوطرفه کردن"
                )


            bothItem.addActionListener {

                makeBidirectional()
            }


            menu.add(
                bothItem
            )
        }


        menu.addSeparator()


        JMenuItem deleteItem =
            new JMenuItem(
                "✕ حذف Connector"
            )


        deleteItem.addActionListener {

            deleteSelectedConnector()
        }


        menu.add(
            deleteItem
        )


        menu.show(
            this,
            x,
            y
        )
    }


    // ========================================================
    // فاصله نقطه از خط
    // ========================================================

    double distanceToLine(
        double px,
        double py,
        double x1,
        double y1,
        double x2,
        double y2
    ) {

        double dx =
            x2 -
            x1


        double dy =
            y2 -
            y1


        if (
            dx == 0 &&
            dy == 0
        ) {

            return Double.MAX_VALUE
        }


        double t =
            (
                (px - x1) * dx +
                (py - y1) * dy
            ) /
            (
                dx * dx +
                dy * dy
            )


        t =
            Math.max(
                0,
                Math.min(
                    1,
                    t
                )
            )


        double cx =
            x1 +
            t * dx


        double cy =
            y1 +
            t * dy


        return Math.sqrt(
            Math.pow(
                px - cx,
                2
            ) +
            Math.pow(
                py - cy,
                2
            )
        )
    }


    // ========================================================
    // پیدا کردن Connector
    // ========================================================

    GEdge findEdge(
        double mx,
        double my
    ) {

        for (
            GEdge edge :
            graphEdges
        ) {

            double d =
                distanceToLine(
                    mx,
                    my,
                    edge.source.x,
                    edge.source.y,
                    edge.target.x,
                    edge.target.y
                )


            if (
                d <= 10
            ) {

                return edge
            }
        }


        return null
    }


    // ========================================================
    // رسم
    // ========================================================

    @Override
    protected void paintComponent(
        Graphics g
    ) {

        super.paintComponent(g)


        Graphics2D g2 =
            (Graphics2D)g


        g2.setRenderingHint(
            RenderingHints.KEY_ANTIALIASING,
            RenderingHints.VALUE_ANTIALIAS_ON
        )


        // ====================================================
        // نوار وضعیت قفل
        // ====================================================

        if (
            graphLocked
        ) {

            g2.setColor(
                new Color(
                    255,
                    245,
                    200
                )
            )


            g2.fillRect(
                0,
                0,
                getWidth(),
                38
            )


            g2.setColor(
                Color.DARK_GRAY
            )


            g2.setFont(
                new Font(
                    "Arial",
                    Font.BOLD,
                    14
                )
            )


            g2.drawString(
                "🔒 Graph Lock — انتخاب Node در نقشه = افزودن به Graph",
                15,
                25
            )
        }


        // ====================================================
        // Connectorها
        // ====================================================

        graphEdges.each {

            edge ->


            def connector =
                edge.connector


            boolean startArrow =
                connector.hasStartArrow()


            boolean endArrow =
                connector.hasEndArrow()


            if (
                edge ==
                selectedEdge
            ) {

                g2.setColor(
                    Color.ORANGE
                )


                g2.setStroke(
                    new BasicStroke(
                        5
                    )
                )

            } else {

                g2.setColor(
                    Color.DARK_GRAY
                )


                g2.setStroke(
                    new BasicStroke(
                        3
                    )
                )
            }


            g2.drawLine(
                (int)edge.source.x,
                (int)edge.source.y,
                (int)edge.target.x,
                (int)edge.target.y
            )


            if (
                endArrow
            ) {

                drawArrowHeadAtNode(
                    g2,
                    edge.source.x,
                    edge.source.y,
                    edge.target.x,
                    edge.target.y
                )
            }


            if (
                startArrow
            ) {

                drawArrowHeadAtNode(
                    g2,
                    edge.target.x,
                    edge.target.y,
                    edge.source.x,
                    edge.source.y
                )
            }
        }


        // ====================================================
        // Nodeها
        // ====================================================

        graphNodes.each {

            n ->


            int radius =
                42


            if (
                n.selected
            ) {

                g2.setColor(
                    Color.YELLOW
                )

            } else {

                g2.setColor(
                    Color.LIGHT_GRAY
                )
            }


            g2.fillOval(
                (int)n.x -
                radius,

                (int)n.y -
                radius,

                radius * 2,

                radius * 2
            )


            g2.setColor(
                Color.DARK_GRAY
            )


            g2.setStroke(
                new BasicStroke(
                    2
                )
            )


            g2.drawOval(
                (int)n.x -
                radius,

                (int)n.y -
                radius,

                radius * 2,

                radius * 2
            )


            String text =
                n.text


            if (
                text.length() > 18
            ) {

                text =
                    text.substring(
                        0,
                        18
                    ) +
                    "..."
            }


            FontMetrics fm =
                g2.getFontMetrics()


            int width =
                fm.stringWidth(
                    text
                )


            g2.setColor(
                Color.BLACK
            )


            g2.drawString(
                text,

                (int)n.x -
                width / 2,

                (int)n.y +
                5
            )
        }
    }


    // ========================================================
    // رسم Arrow
    // ========================================================

    void drawArrowHeadAtNode(
        Graphics2D g2,
        double x1,
        double y1,
        double x2,
        double y2
    ) {

        double dx =
            x2 -
            x1


        double dy =
            y2 -
            y1


        double distance =
            Math.sqrt(
                dx * dx +
                dy * dy
            )


        if (
            distance == 0
        ) {

            return
        }


        double ux =
            dx /
            distance


        double uy =
            dy /
            distance


        double nodeRadius =
            42


        double gap =
            3


        double tipX =
            x2 -
            ux *
            (
                nodeRadius +
                gap
            )


        double tipY =
            y2 -
            uy *
            (
                nodeRadius +
                gap
            )


        double arrowLength =
            18


        double arrowWidth =
            10


        double baseX =
            tipX -
            ux *
            arrowLength


        double baseY =
            tipY -
            uy *
            arrowLength


        double px =
            -uy


        double py =
            ux


        Polygon arrow =
            new Polygon()


        arrow.addPoint(
            (int)tipX,
            (int)tipY
        )


        arrow.addPoint(
            (int)(
                baseX +
                px *
                arrowWidth
            ),

            (int)(
                baseY +
                py *
                arrowWidth
            )
        )


        arrow.addPoint(
            (int)(
                baseX -
                px *
                arrowWidth
            ),

            (int)(
                baseY -
                py *
                arrowWidth
            )
        )


        g2.fillPolygon(
            arrow
        )
    }
}


// ============================================================
// ساخت پنجره
// ============================================================

SwingUtilities.invokeLater {

    JFrame frame =
        new JFrame(
            "Freeplane Connector Graph"
        )


    frame.setDefaultCloseOperation(
        JFrame.DISPOSE_ON_CLOSE
    )


    frame.setSize(
        1200,
        800
    )


    frame.setLocationRelativeTo(
        null
    )


    // ========================================================
    // Graph Panel
    // ========================================================

    GraphPanel panel =
        new GraphPanel(
            selectedNode,
            c
        )


    frame.add(
        panel
    )


    // ========================================================
    // دکمه Lock
    // ========================================================

    JToolBar toolbar =
        new JToolBar()


    toolbar.setFloatable(
        false
    )


    JButton lockButton =
        new JButton(
            "🔓 قفل Graph"
        )


    lockButton.setFocusPainted(
        false
    )


    lockButton.addActionListener {

        panel.graphLocked =
            !panel.graphLocked


        if (
            panel.graphLocked
        ) {

            lockButton.setText(
                "🔒 Graph قفل است"
            )

        } else {

            lockButton.setText(
                "🔓 قفل Graph"
            )
        }


        panel.repaint()
    }


    toolbar.add(
        lockButton
    )


    frame.add(
        toolbar,
        BorderLayout.NORTH
    )


    // ========================================================
    // نمایش
    // ========================================================

    frame.setVisible(
        true
    )


    panel.requestFocusInWindow()


    panel.lastSelectedNodeId =
        selectedNode.nodeID


    // ========================================================
    // Timer
    // ========================================================

    Timer selectionTimer =
        new Timer(
            150,
            new ActionListener() {

                @Override
                void actionPerformed(
                    ActionEvent e
                ) {

                    if (
                        !frame.isDisplayable()
                    ) {

                        ((Timer)
                            e.getSource()
                        ).stop()


                        return
                    }


                    panel.checkSelectionChange()
                }
            }
        )


    selectionTimer.setRepeats(
        true
    )


    selectionTimer.start()


    // ========================================================
    // توقف Timer
    // ========================================================

    frame.addWindowListener(
        new WindowAdapter() {

            @Override
            void windowClosed(
                WindowEvent e
            ) {

                selectionTimer.stop()
            }
        }
    )
}
